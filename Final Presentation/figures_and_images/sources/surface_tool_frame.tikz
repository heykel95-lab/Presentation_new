% Shared tool and surface frame. Identical source in thesis and presentation.
% The tool-face centre is the frame origin, with its long centreline on t_2.
\begin{scope}
  \draw[black,thin] (-1.267,0.000) -- (-0.180,-0.505) -- (0.967,0.300)
      -- (-0.120,0.805) -- cycle;
  % Draw the reference axes first. The opaque tool faces hide their internal
  % portions, while the normal continues above the coaxial tool shaft.
  \draw[-{Latex[length=1.8mm]},black] (0,0) -- (1.586,-0.740);
  \node[font=\footnotesize,inner sep=1.8pt,anchor=west] at (1.66,-0.79) {$t_1$};
  \draw[-{Latex[length=1.8mm]},black] (0,0) -- (1.310,0.918);
  \node[font=\footnotesize,inner sep=1.8pt,anchor=south west] at (1.36,0.96) {$t_2$};
  \draw[-{Latex[length=2mm]},thick,black] (0,0) -- (0,1.20);
  \node[font=\footnotesize,inner sep=1.8pt,anchor=south] at (0,1.32) {$n_s$};
  % Local x = t_1 (width), y = t_2 (length), z = n_s (thickness).
  % The 1:3 face proportions represent the documented 40 x 120 mm tool.
  % Equal +/- half-lengths about the frame origin and centred tool shaft.
  \begin{scope}[
      x={(0.906cm,-0.423cm)}, y={(0.819cm,0.574cm)}, z={(0cm,1cm)}]
    \def\toolHalfWidth{0.12}
    \def\toolHalfLength{0.36}
    \def\toolHeight{0.30}
    \path[draw=green!60!black,fill=green!8!white,line width=0.65pt]
      (-\toolHalfWidth,-\toolHalfLength,0) -- (\toolHalfWidth,-\toolHalfLength,0)
      -- (\toolHalfWidth,\toolHalfLength,0) -- (-\toolHalfWidth,\toolHalfLength,0) -- cycle;
    \path[draw=green!60!black,fill=green!16!white,line width=0.65pt]
      (-\toolHalfWidth,-\toolHalfLength,0) -- (\toolHalfWidth,-\toolHalfLength,0)
      -- (\toolHalfWidth,-\toolHalfLength,\toolHeight)
      -- (-\toolHalfWidth,-\toolHalfLength,\toolHeight) -- cycle;
    \path[draw=green!60!black,fill=green!25!white,line width=0.65pt]
      (\toolHalfWidth,-\toolHalfLength,0) -- (\toolHalfWidth,\toolHalfLength,0)
      -- (\toolHalfWidth,\toolHalfLength,\toolHeight)
      -- (\toolHalfWidth,-\toolHalfLength,\toolHeight) -- cycle;
    \path[draw=green!60!black,fill=green!8!white,line width=0.65pt]
      (-\toolHalfWidth,-\toolHalfLength,\toolHeight) -- (\toolHalfWidth,-\toolHalfLength,\toolHeight)
      -- (\toolHalfWidth,\toolHalfLength,\toolHeight) -- (-\toolHalfWidth,\toolHalfLength,\toolHeight) -- cycle;
    \draw[green!60!black,line width=2.4pt] (0,0,\toolHeight) -- (0,0,0.75);
  \end{scope}
  \node[font=\footnotesize,green!60!black,anchor=south] at (-0.55,0.82) {Tool};
\end{scope}
