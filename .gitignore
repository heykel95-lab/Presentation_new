# LibreOffice / OpenOffice lock files
.~lock.*#

# Office temp files
~$*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Speaking-script compiler output, previews, and local backups
/Final Presentation/Speaking/build/*
!/Final Presentation/Speaking/build/update-overview.ps1
/Final Presentation/overview_build/

# LaTeX intermediate files
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz

# Local rendering workspaces and Python bytecode
/tmp/
__pycache__/
*.pyc

# Local rollback copies; final assets and verification records stay tracked
/experiments/**/archive/

# Local dependencies and generated outputs from presentation edit workspaces
node_modules/
/experiments/*_20261001/*.pdf
/experiments/*_20261001/*.png
/experiments/*_20261001/*.jpg
/experiments/*_20261001/*.svg
/experiments/*_20261001/*.pptx
/experiments/*_20261001/*.xml
/experiments/*_20261001/*.xml.rels
/experiments/*_20261001/*.bin
/experiments/*_20261001/duplicate*_cleanup*.json
/experiments/*_20261001/*-build.txt
/experiments/*_20261001/latex-build.txt

# Compiled figures beside their editable sources; final exports live one level up
/Final Presentation/figures_and_images/sources/*.pdf
